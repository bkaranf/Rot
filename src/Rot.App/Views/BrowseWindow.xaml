<Window x:Class="Rot.App.Views.BrowseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rot Browse"
        Width="980"
        Height="720"
        MinWidth="680"
        MinHeight="480"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#0A0A0B"
        Topmost="True"
        ShowInTaskbar="True"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="ToolbarButton" TargetType="Button">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Padding" Value="7" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBackground"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBackground" Property="Background" Value="#2C2C2E" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBackground" Property="Opacity" Value="0.65" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonBackground" Property="Background" Value="#2C2C2E" />
                <Setter TargetName="ButtonBackground" Property="BorderBrush" Value="#E5383B" />
                <Setter TargetName="ButtonBackground" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.3" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NoticeButton" TargetType="Button">
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Background" Value="#2C2C2E" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Resources>

  <Grid x:Name="Root" Background="#0A0A0B">
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="#1C1C1E"
            BorderBrush="#14FFFFFF"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="OnToolbarMouseLeftButtonDown">
      <Grid Margin="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button x:Name="BackButton"
                Grid.Column="0"
                IsEnabled="False"
                Style="{StaticResource ToolbarButton}"
                ToolTip="Back"
                AutomationProperties.Name="Back"
                Click="OnBackClick">
          <Path Width="20"
                Height="20"
                Stretch="Uniform"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.5"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round"
                Data="M 12,3 L 5,10 L 12,17 M 5,10 L 18,10" />
        </Button>

        <Button Grid.Column="1"
                Style="{StaticResource ToolbarButton}"
                ToolTip="YouTube home"
                AutomationProperties.Name="YouTube home"
                Click="OnHomeClick">
          <Path Width="20"
                Height="20"
                Stretch="Uniform"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.5"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round"
                Data="M 3,9 L 10,3 L 17,9 M 5,8 L 5,17 L 15,17 L 15,8 M 8,17 L 8,12 L 12,12 L 12,17" />
        </Button>

        <Border Grid.Column="2"
                x:Name="InputBorder"
                Height="36"
                Margin="6,0,10,0"
                Padding="12,0"
                Background="#2C2C2E"
                CornerRadius="8">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="BorderBrush" Value="#2C2C2E" />
              <Setter Property="BorderThickness" Value="1" />
              <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter Property="BorderBrush" Value="#E5383B" />
                  <Setter Property="BorderThickness" Value="2" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBox x:Name="InputBox"
                   VerticalContentAlignment="Center"
                   Background="Transparent"
                   BorderThickness="0"
                   Foreground="#FFFFFF"
                   CaretBrush="#FFFFFF"
                   FontFamily="Segoe UI Variable Display, Segoe UI"
                   FontSize="14"
                   ToolTip="YouTube URL, video ID, or search"
                   AutomationProperties.Name="YouTube URL, video ID, or search"
                   KeyDown="OnInputKeyDown" />
        </Border>

        <Button Grid.Column="3"
                Margin="0"
                Style="{StaticResource ToolbarButton}"
                ToolTip="Close Browse"
                AutomationProperties.Name="Close Browse"
                Click="OnCloseClick">
          <Path Width="20"
                Height="20"
                Stretch="Uniform"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.5"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                Data="M 4,4 L 16,16 M 16,4 L 4,16" />
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Background="#0A0A0B">
      <Grid x:Name="BrowserHost" Background="#0A0A0B" />

      <Border x:Name="NoticePanel"
              Width="480"
              MaxWidth="560"
              Margin="24"
              Padding="24"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="#1C1C1E"
              BorderBrush="#14FFFFFF"
              BorderThickness="1"
              CornerRadius="10"
              Visibility="Collapsed">
        <StackPanel>
          <TextBlock x:Name="NoticeTitle"
                     Foreground="#FFFFFF"
                     FontFamily="Segoe UI Variable Display, Segoe UI"
                     FontSize="20"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="NoticeMessage"
                     Margin="0,12,0,20"
                     Foreground="#99EBEBF5"
                     FontFamily="Segoe UI Variable Display, Segoe UI"
                     FontSize="13"
                     LineHeight="20"
                     TextWrapping="Wrap" />
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="OpenExternalButton"
                    Style="{StaticResource NoticeButton}"
                    Background="#E5383B"
                    Content="Open in browser"
                    Click="OnOpenExternalClick" />
            <Button x:Name="DismissNoticeButton"
                    Style="{StaticResource NoticeButton}"
                    Content="Back to YouTube"
                    Click="OnDismissNoticeClick" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
