<Window x:Class="Rot.App.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rot"
        Width="640"
        Height="360"
        MinWidth="320"
        MinHeight="180"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#0A0A0B"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
  <Grid x:Name="Root" Background="#0A0A0B">
    <Grid x:Name="BrowserHost" Background="#0A0A0B" />
  </Grid>
</Window>
