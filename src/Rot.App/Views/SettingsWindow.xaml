<Window x:Class="Rot.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rot Settings"
        Width="460"
        Height="720"
        MinWidth="390"
        MinHeight="520"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#0A0A0B"
        Topmost="True"
        ShowInTaskbar="True"
        UseLayoutRounding="True">
  <Grid x:Name="Root" Background="#0A0A0B">
    <Grid x:Name="BrowserHost" Background="#0A0A0B" />
  </Grid>
</Window>
